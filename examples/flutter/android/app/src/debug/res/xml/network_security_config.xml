<?xml version="1.0" encoding="utf-8"?>
<!-- Debug builds only: cleartext http to an Aruma on your computer, reached as 127.0.0.1 through
     `adb reverse`, or as 10.0.2.2 from the emulator. Release builds keep Android's default (no
     cleartext): use https there. -->
<network-security-config>
    <domain-config cleartextTrafficPermitted="true">
        <domain includeSubdomains="false">127.0.0.1</domain>
        <domain includeSubdomains="false">localhost</domain>
        <domain includeSubdomains="false">10.0.2.2</domain>
    </domain-config>
</network-security-config>
