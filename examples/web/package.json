{
  "name": "team-board-web",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "Team Board: an example web app on the official Firebase JS SDK (Auth, Firestore, Realtime Database, Storage) that runs on Aruma, Firebase or the Firebase emulators.",
  "license": "Apache-2.0",
  "scripts": {
    "dev": "vite",
    "build": "tsc -b && vite build",
    "preview": "vite preview",
    "typecheck": "tsc -b",
    "lint": "eslint . --max-warnings 0",
    "deploy:aruma": "node scripts/deploy-aruma.mjs",
    "e2e": "e2e/run.sh",
    "screenshots": "e2e/run.sh --screenshots"
  },
  "dependencies": {
    "firebase": "^13.1.0",
    "react": "^19.2.0",
    "react-dom": "^19.2.0"
  },
  "devDependencies": {
    "@aruma/web": "file:../../sdk/web/aruma-web",
    "@eslint/js": "^10.0.1",
    "@playwright/test": "1.64.1",
    "@types/node": "^24.0.0",
    "@types/react": "^19.2.0",
    "@types/react-dom": "^19.2.0",
    "@vitejs/plugin-react": "^6.3.0",
    "eslint": "^10.15.0",
    "eslint-plugin-react-hooks": "^7.1.1",
    "globals": "^17.0.0",
    "typescript": "~6.0.3",
    "typescript-eslint": "^8.73.0",
    "vite": "^8.0.0"
  },
  "engines": {
    "node": ">=20.19"
  }
}
