+// SPDX-License-Identifier: Apache-2.0
+//
+// Added to FirebaseStorage by the Aruma patch (sdk/ios/firebase-storage-patch in
+// https://github.com/arumadev/aruma). It is not part of the official firebase-ios-sdk.
+
+import Foundation
+
+/// Where Storage sends its requests and builds its download URLs: `scheme://host[:port]`.
+///
+/// The app's Info.plist names an Aruma server with `ArumaURL`, the key ArumaRedirect reads too.
+/// Storage then talks to that server, and `downloadURL()` returns the unified form
+/// `https://<aruma-host>/v0/b/<bucket>/o/<name>?alt=media&token=<uuid>`, with no port unless
+/// ArumaURL has one. Without the key, Storage keeps the official behaviour
+/// (`https://firebasestorage.googleapis.com:443`) and logs one line saying so.
+struct ArumaStorageOrigin: Equatable {
+  let scheme: String
+  let host: String
+  /// nil: no port in the URLs (the scheme's default).
+  let port: Int?
+
+  /// The official endpoint, as FirebaseStorage sets it.
+  static let google = ArumaStorageOrigin(scheme: "https", host: "firebasestorage.googleapis.com",
+                                         port: 443)
+  /// ArumaURL is set but refused. The `.invalid` name never resolves (RFC 6761), so requests fail
+  /// instead of reaching Google.
+  static let refused = ArumaStorageOrigin(scheme: "https", host: "arumaurl.invalid", port: nil)
+
+  /// String: the Aruma server, `https://aruma.example.com[:port]`.
+  static let urlKey = "ArumaURL"
+  /// Bool: accept `http` to a host that is not loopback. Development only.
+  static let allowInsecureKey = "ArumaAllowInsecureURL"
+
+  /// Read from the main bundle's Info.plist once per process, and logged once.
+  static let main: ArumaStorageOrigin = {
+    let (origin, message) = resolve(Bundle.main.infoDictionary ?? [:])
+    NSLog("FirebaseStorage (Aruma build): %@", message)
+    return origin
+  }()
+
+  /// The origin an Info.plist dictionary names, and the line to log about it.
+  static func resolve(_ info: [String: Any]) -> (ArumaStorageOrigin, String) {
+    guard let raw = (info[urlKey] as? String)?.trimmingCharacters(in: .whitespacesAndNewlines),
+          !raw.isEmpty else {
+      return (google, "ArumaURL is not set in Info.plist, so Storage uses " +
+        "https://firebasestorage.googleapis.com, as the official SDK does")
+    }
+    switch parse(raw, allowInsecure: boolValue(info[allowInsecureKey])) {
+    case let .success(origin):
+      return (origin, "Storage uses \(origin.description) (ArumaURL)")
+    case let .failure(reason):
+      return (refused, "ArumaURL \"\(raw)\" is refused (\(reason.text)); Storage requests " +
+        "fail instead of reaching Google")
+    }
+  }
+
+  struct Refusal: Error, Equatable {
+    let text: String
+  }
+
+  /// `scheme://host[:port]` with nothing else: Aruma serves Storage from the root of its host.
+  /// The host is written in lower case, and the scheme's default port is dropped.
+  static func parse(_ raw: String, allowInsecure: Bool) -> Result<ArumaStorageOrigin, Refusal> {
+    guard let c = URLComponents(string: raw),
+          let scheme = c.scheme?.lowercased(), scheme == "https" || scheme == "http",
+          let host = c.host?.lowercased(), !host.isEmpty else {
+      return .failure(Refusal(text: "not an absolute http(s) URL with a host"))
+    }
+    if c.query != nil || c.fragment != nil || c.user != nil || c.password != nil {
+      return .failure(Refusal(text: "it has a query, a fragment or credentials"))
+    }
+    if !(c.percentEncodedPath.isEmpty || c.percentEncodedPath == "/") {
+      return .failure(Refusal(text: "it has a path; Storage is served from the root of the host"))
+    }
+    if scheme == "http", !allowInsecure, !isLoopback(host) {
+      return .failure(Refusal(text: "http to a host that is not loopback; use https, or set " +
+          "ArumaAllowInsecureURL for development"))
+    }
+    var port = c.port
+    if port == (scheme == "https" ? 443 : 80) {
+      port = nil
+    }
+    return .success(ArumaStorageOrigin(scheme: scheme, host: host, port: port))
+  }
+
+  var description: String {
+    var c = URLComponents()
+    c.scheme = scheme
+    c.host = host
+    c.port = port
+    return c.string ?? "\(scheme)://\(host)"
+  }
+
+  /// `localhost`, `127.0.0.0/8` and `::1`, as in ArumaRedirect.
+  static func isLoopback(_ host: String) -> Bool {
+    let h = host.lowercased().trimmingCharacters(in: CharacterSet(charactersIn: "[]"))
+    if h == "localhost" || h == "::1" {
+      return true
+    }
+    let octets = h.split(separator: ".", omittingEmptySubsequences: false)
+    guard octets.count == 4, octets[0] == "127" else {
+      return false
+    }
+    return octets.allSatisfy { part in
+      !part.isEmpty && part.count <= 3 && part.allSatisfy(\.isASCII) && UInt8(part) != nil
+    }
+  }
+
+  private static func boolValue(_ value: Any?) -> Bool {
+    switch value {
+    case let b as Bool: return b
+    case let n as NSNumber: return n.boolValue
+    case let s as String: return ["1", "yes", "true"].contains(s.lowercased())
+    default: return false
+    }
+  }
+}
