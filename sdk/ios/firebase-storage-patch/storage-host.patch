+// Copyright 2026 The Aruma Authors
+// SPDX-License-Identifier: Apache-2.0
+//
+// Added to FirebaseStorage by the Aruma patch (sdk/ios/firebase-storage-patch in
+// https://github.com/arumadev/aruma). It is not part of the official firebase-ios-sdk.
+
+import Foundation
+
+import FirebaseCore
+@testable import FirebaseStorage
+import GTMSessionFetcherCore
+
+import XCTest
+
+class ArumaStorageOriginTests: StorageTestHelpers {
+  private func origin(_ info: [String: Any]) -> ArumaStorageOrigin {
+    ArumaStorageOrigin.resolve(info).0
+  }
+
+  private func storage(at origin: ArumaStorageOrigin) -> Storage {
+    let storage = storage()
+    storage.scheme = origin.scheme
+    storage.host = origin.host
+    storage.port = origin.port
+    return storage
+  }
+
+  /// The unit tests run without ArumaURL: every Storage keeps the official endpoint.
+  func testWithoutArumaURLStorageIsOfficial() {
+    XCTAssertEqual(origin([:]), .google)
+    XCTAssertEqual(origin(["ArumaURL": "  "]), .google)
+    XCTAssertEqual(ArumaStorageOrigin.main, .google)
+    let storage = storage()
+    XCTAssertEqual(storage.scheme, "https")
+    XCTAssertEqual(storage.host, "firebasestorage.googleapis.com")
+    XCTAssertEqual(storage.port, 443)
+    XCTAssertTrue(ArumaStorageOrigin.resolve([:]).1.contains("ArumaURL is not set"))
+  }
+
+  func testArumaURLWithoutPortHasNoPort() throws {
+    let aruma = origin(["ArumaURL": "https://Aruma.Example.com"])
+    XCTAssertEqual(aruma, ArumaStorageOrigin(scheme: "https", host: "aruma.example.com", port: nil))
+    let ref = StorageReference(storage: storage(at: aruma),
+                               path: StoragePath(with: "bucket", object: "path/to/object"))
+
+    let request = StorageUtils.defaultRequestForReference(reference: ref)
+    XCTAssertNil(request.url?.port)
+    XCTAssertEqual(request.url?.absoluteString,
+                   "https://aruma.example.com/v0/b/bucket/o/path%2Fto%2Fobject")
+
+    let url = try XCTUnwrap(StorageGetDownloadURLTask.downloadURLFromMetadataDictionary(
+      ["bucket": "bucket", "name": "path/to/object", "downloadTokens": "12345,678"], ref
+    ))
+    XCTAssertNil(url.port)
+    XCTAssertEqual(url.absoluteString,
+                   "https://aruma.example.com/v0/b/bucket/o/path%2Fto%2Fobject?alt=media&token=12345")
+  }
+
+  func testArumaURLWithoutPortSendsNoPort() async throws {
+    let storage = storage(at: origin(["ArumaURL": "https://aruma.example.com/"]))
+    let testBlock = { (fetcher: GTMSessionFetcher, response: GTMSessionFetcherTestResponse) in
+      let url = fetcher.request!.url!
+      XCTAssertEqual(url.scheme, "https")
+      XCTAssertEqual(url.host, "aruma.example.com")
+      XCTAssertNil(url.port)
+      XCTAssertEqual(url.path, "/v0/b/bucket/o")
+      response(HTTPURLResponse(url: url, statusCode: 200, httpVersion: "HTTP/1.1",
+                               headerFields: nil), nil, nil)
+    }
+    await StorageFetcherService.shared.updateTestBlock(testBlock)
+    do {
+      _ = try await storage.reference(withPath: "object").list(maxResults: 10)
+    } catch {
+      // All testing is in the test block.
+    }
+  }
+
+  func testExplicitPortsAndDefaultPorts() {
+    XCTAssertEqual(origin(["ArumaURL": "https://aruma.example.com:8443"]).port, 8443)
+    XCTAssertNil(origin(["ArumaURL": "https://aruma.example.com:443"]).port)
+    XCTAssertEqual(origin(["ArumaURL": "http://localhost:9440"]),
+                   ArumaStorageOrigin(scheme: "http", host: "localhost", port: 9440))
+    XCTAssertEqual(origin(["ArumaURL": "HTTP://LOCALHOST:9440"]),
+                   ArumaStorageOrigin(scheme: "http", host: "localhost", port: 9440))
+    XCTAssertNil(origin(["ArumaURL": "http://127.0.0.1:80"]).port)
+  }
+
+  func testInsecureHTTP() {
+    XCTAssertEqual(origin(["ArumaURL": "http://aruma.lan:9440"]), .refused)
+    XCTAssertEqual(origin(["ArumaURL": "http://aruma.lan:9440", "ArumaAllowInsecureURL": true]),
+                   ArumaStorageOrigin(scheme: "http", host: "aruma.lan", port: 9440))
+    XCTAssertEqual(origin(["ArumaURL": "http://127.0.0.1.evil.example"]), .refused)
+  }
+
+  /// A refused ArumaURL never falls back to Google.
+  func testRefusedArumaURL() {
+    for bad in ["aruma.example.com", "ftp://aruma.example.com", "https://", "https://a.example?x=1",
+                "https://a.example#f", "https://user:pw@a.example", "https://a.example/prefix"] {
+      XCTAssertEqual(origin(["ArumaURL": bad]), .refused, bad)
+    }
+    XCTAssertTrue(ArumaStorageOrigin.resolve(["ArumaURL": "https://a.example/prefix"]).1
+      .contains("served from the root"))
+  }
+
+  /// useEmulator still wins over ArumaURL.
+  func testUseEmulatorOverridesArumaURL() {
+    let storage = storage(at: origin(["ArumaURL": "https://aruma.example.com"]))
+    storage.useEmulator(withHost: "localhost", port: 8080)
+    XCTAssertEqual(storage.scheme, "http")
+    XCTAssertEqual(storage.host, "localhost")
+    XCTAssertEqual(storage.port, 8080)
+  }
+}
