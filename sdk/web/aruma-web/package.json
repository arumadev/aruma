{
  "name": "@aruma/web",
  "version": "0.1.0",
  "description": "Send the official Firebase web SDK (Auth and Storage), in production mode, to an Aruma server: one line in the bundler's config, no change in the app.",
  "license": "Apache-2.0",
  "type": "module",
  "exports": {
    ".": {
      "types": "./index.d.ts",
      "default": "./src/index.js"
    },
    "./auto": {
      "types": "./auto.d.ts",
      "default": "./src/auto.js"
    },
    "./vite": {
      "types": "./vite.d.ts",
      "default": "./src/vite.js"
    },
    "./storage": {
      "types": "./storage.d.ts",
      "default": "./src/storage.js"
    },
    "./unplugin": {
      "types": "./unplugin.d.ts",
      "default": "./src/unplugin.js"
    },
    "./metro": {
      "types": "./metro.d.ts",
      "default": "./src/metro.js"
    },
    "./flutter-web": {
      "types": "./flutter-web.d.ts",
      "default": "./src/flutter-web.js"
    },
    "./package.json": "./package.json"
  },
  "types": "./index.d.ts",
  "bin": {
    "aruma-web": "src/cli.js"
  },
  "sideEffects": [
    "./src/auto.js"
  ],
  "files": [
    "src/",
    "index.d.ts",
    "auto.d.ts",
    "vite.d.ts",
    "storage.d.ts",
    "unplugin.d.ts",
    "metro.d.ts",
    "flutter-web.d.ts",
    "README.md",
    "LICENSE"
  ],
  "engines": {
    "node": ">=20.19"
  },
  "dependencies": {
    "unplugin": "^3.4.0"
  },
  "scripts": {
    "test": "node --test test/*.test.js"
  }
}
