{
  "name": "@aruma/admin-auth",
  "version": "0.1.0",
  "description": "Verify Aruma ID tokens and session cookies and manage Aruma Auth users, returning the official firebase-admin types.",
  "license": "Apache-2.0",
  "type": "module",
  "exports": {
    ".": {
      "types": "./index.d.ts",
      "default": "./index.js"
    }
  },
  "main": "./index.js",
  "types": "./index.d.ts",
  "files": [
    "index.js",
    "index.d.ts",
    "lib/",
    "README.md",
    "LICENSE"
  ],
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "test": "tsc -p tsconfig.json && node --test --test-concurrency=1 --test-timeout=300000 test/*.test.js",
    "typecheck": "tsc -p tsconfig.json"
  },
  "peerDependencies": {
    "firebase-admin": "^14"
  },
  "devDependencies": {
    "firebase-admin": "^14.5.0",
    "typescript": "^5.9.3"
  }
}
