 "version": "firebaserules.googleapis.com v1 projects.test",
 "rulesets": {
  "pack-1": "rules_version = '2';\nservice cloud.firestore {\n  match /databases/{database}/documents {\n    match /c_read_get/{doc} {\n      allow read: if true;\n    }\n    match /c_read_list/{doc} {\n      allow read: if true;\n    }\n    match /c_get_list/{doc} {\n      allow get: if true;\n    }\n    match /c_write_create/{doc} {\n      allow write: if true;\n    }\n    match /c_write_update/{doc} {\n      allow write: if true;\n    }\n    match /c_write_delete/{doc} {\n      allow write: if true;\n    }\n    match /c_create_update/{doc} {\n      allow create: if true;\n    }\n    match /c_update_create/{doc} {\n      allow update: if true;\n    }\n    match /c_delete_update/{doc} {\n      allow delete: if true;\n    }\n    match /c_read_create/{doc} {\n      allow read: if true;\n    }\n    match /c_write_get/{doc} {\n      allow write: if true;\n    }\n    match /c_get_list_both/{doc} {\n      allow get, list: if true;\n    }\n    match /c_method_get/{doc} {\n      allow read: if request.method == 'get';\n    }\n    match /c_method_list/{doc} {\n      allow read: if request.method == 'list';\n    }\n    match /c_method_create/{doc} {\n      allow write: if request.method == 'create';\n    }\n    match /c_method_update/{doc} {\n      allow write: if request.method == 'update';\n    }\n    match /c_method_delete/{doc} {\n      allow write: if request.method == 'delete';\n    }\n    match /c_create_resource_null/{doc} {\n      allow create: if resource == null;\n    }\n    match /c_create_request_resource/{doc} {\n      allow create: if request.resource.data.owner == request.auth.uid;\n    }\n    match /c_delete_request_resource_null/{doc} {\n      allow delete: if request.resource == null;\n    }\n    match /c_delete_resource/{doc} {\n      allow delete: if resource.data.owner == 'alice';\n    }\n    match /c_list_query_limit/{doc} {\n      allow list: if request.query.limit <= 10;\n    }\n    match /c_method_write_verb/{doc} {\n      allow write: if true;\n    }\n  }\n}\n"
 },
 "resources": {
  "default": {
   "data": {
    "n": 1,
    "f": 1.5,
    "s": "abc",
    "b": true,
    "nul": null,
    "arr": [
     1,
     2,
     3
    ],
    "tags": [
     "a",
     "b"
    ],
    "m": {
     "x": 1,
     "y": "z"
    },
    "owner": "alice"
   }
  }
 },
