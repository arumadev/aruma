 "recordedAt": "2026-10-23T21:44:03.794Z",
 "version": "firebaserules.googleapis.com v1 projects.test",
 "rulesets": {
  "pack-1": "rules_version = '2';\nservice cloud.firestore {\n  match /databases/{database}/documents {\n    match /c_literal_ne/{doc} {\n      allow get: if /a/b != /a/c;\n    }\n    match /c_interpolate/{doc} {\n      allow get: if /databases/$(database)/documents/c_interpolate/$(doc) == request.path;\n    }\n    match /c_interpolate_slash/{doc} {\n      allow get: if /a/$('b/c')/d == /a/b/c/d;\n    }\n    match /c_interpolate_slash_size/{doc} {\n      allow get: if /a/$('b/c')/d[1] == 'b/c';\n    }\n    match /c_interpolate_int/{doc} {\n      allow get: if /a/$(1) == /a/1;\n    }\n    match /c_path_fn_relative/{doc} {\n      allow get: if path('a/b') == /a/b;\n    }\n    match /c_path_index/{doc} {\n      allow get: if /a/b/c[1] == 'b';\n    }\n    match /c_path_index_out_of_range/{doc} {\n      allow get: if /a/b[5] == 'x';\n    }\n    match /c_path_eq_string/{doc} {\n      allow get: if /a/b == '/a/b';\n    }\n    match /c_path_string/{doc} {\n      allow get: if string(/a/b) == '/a/b';\n    }\n    match /c_path_concat/{doc} {\n      allow get: if /a/b + '/c' == '/a/b/c';\n    }\n    match /c_request_path_index/{doc} {\n      allow get: if request.path[3] == 'c_request_path_index';\n    }\n    match /c_request_path_tail/{doc} {\n      allow get: if request.path[4] == 'doc';\n    }\n    match /c_path_is_path/{doc} {\n      allow get: if /a/b is path;\n    }\n    match /c_path_in/{doc} {\n      allow get: if 'b' in /a/b;\n    }\n    match /c_path_special_chars/{doc} {\n      allow get: if /a/$('b c')/d[1] == 'b c';\n    }\n    match /c_path_encoded_segment/{doc} {\n      allow get: if /a/b%20c[1] == 'b c';\n    }\n    match /c_path_dot_segment/{doc} {\n      allow get: if /a/b.c[1] == 'b.c';\n    }\n    match /c_path_dash_segment/{doc} {\n      allow get: if /a/b-c[1] == 'b-c';\n    }\n    match /c_path_parens_segment/{doc} {\n      allow get: if /databases/(default)/documents[1] == '(default)';\n    }\n  }\n}\n"
 },
 "resources": {
  "default": {
   "data": {
    "n": 1,
    "f": 1.5,
    "s": "abc",
    "b": true,
    "nul": null,
    "arr": [
     1,
     2,
     3
    ],
    "tags": [
     "a",
     "b"
    ],
    "m": {
     "x": 1,
     "y": "z"
    },
    "owner": "alice"
   }
  }
 },
