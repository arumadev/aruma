 "note": "S1-E probe after the held-out run (paths.mjs in .cache/briefs/reviews/s1e-artifacts): how the Test API reads a percent-encoded request path, and string() of a {x=**} path. Nothing was deployed.",
 "rulesets": {
  "probe": "rules_version = '2';\nservice firebase.storage {\n  match /b/{bucket}/o {\n    match /enc_space/{f} { allow get: if f == 'a b.txt'; }\n    match /enc_space_raw/{f} { allow get: if f == 'a%20b.txt'; }\n    match /enc_plus/{f} { allow get: if f == 'a b.txt'; }\n    match /enc_plus_raw/{f} { allow get: if f == 'a+b.txt'; }\n    match /enc_slash_one/{f} { allow get: if f == 'a/b.txt'; }\n    match /enc_slash_two/{a}/{b} { allow get: if a == 'a' && b == 'b.txt'; }\n    match /enc_pct/{f} { allow get: if f == 'a%b.txt'; }\n    match /enc_utf8/{f} { allow get: if f == 'é.txt'; }\n    match /enc_path/{f} { allow get: if request.path == /b/demo-oracle.appspot.com/o/enc_path/a%20b.txt; }\n    match /rest_string/{rest=**} { allow get: if string(rest) == '/a/b.txt'; }\n    match /rest_string_one/{rest=**} { allow get: if string(rest) == '/a'; }\n    match /rest_string_enc/{rest=**} { allow get: if string(rest) == '/a%20b'; }\n  }\n}\n"
 },
