    "body": {
     "source": {
      "files": [
       {
        "name": "storage.rules",
        "content": "rules_version = '2';\nservice firebase.storage {\n  match /b/{bucket}/o {\n    match /c_resource_time_created_is_string/{file} {\n      allow get: if resource.timeCreated is string;\n    }\n    match /c_resource_updated_is_ts/{file} {\n      allow get: if resource.updated is timestamp;\n    }\n    match /c_resource_generation_int/{file} {\n      allow get: if resource.generation is int;\n    }\n    match /c_resource_time_created_bad/{file} {\n      allow get: if resource.timeCreated is timestamp;\n    }\n    match /c_request_method/{file} {\n      allow get: if request.method == 'get';\n    }\n    match /c_file_var/{file} {\n      allow get: if file == 'file.txt';\n    }\n    match /c_auth_claim_list/{file} {\n      allow get: if request.auth.token.groups.hasAny(['g1']);\n    }\n    match /c_auth_null_uid_or_true/{file} {\n      allow get: if request.auth.uid == 'x' || true;\n    }\n    match /c_create_size/{file} {\n      allow create: if request.resource.size < 5 * 1024 * 1024;\n    }\n    match /c_delete_request_resource/{file} {\n      allow delete: if request.resource == null;\n    }\n    match /c_write_create/{file} {\n      allow write: if true;\n    }\n    match /c_create_update/{file} {\n      allow create: if true;\n    }\n    match /c_string_plus_int/{file} {\n      allow get: if file + resource.size == 'x';\n    }\n    match /c_matches/{file} {\n      allow get: if file.matches('.*[.]txt');\n    }\n    match /c_map_keys_order/{file} {\n      allow get: if {'b': 1, 'a': 2}.keys() == ['a', 'b'];\n    }\n  }\n}\n"
       }
      ]
     },
