        "name": "firestore.rules",
        "content": "rules_version = '2';\nservice cloud.firestore {\n  match /databases/{database}/documents {\n    match /c_list_get/{doc} {\n      allow list: if true;\n    }\n    match /c_update_both/{doc} {\n      allow update: if request.resource.data.n == resource.data.n + 1;\n    }\n    match /c_update_keys_hasonly/{doc} {\n      allow update: if request.resource.data.diff(resource.data).affectedKeys().hasOnly(['n', 's']);\n    }\n    match /c_method_read_verb/{doc} {\n      allow read: if true;\n    }\n  }\n}\n"
       }
      ]
     },
