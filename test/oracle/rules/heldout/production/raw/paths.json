       {
        "name": "firestore.rules",
        "content": "rules_version = '2';\nservice cloud.firestore {\n  match /databases/{database}/documents {\n    match /c_literal_eq/{doc} {\n      allow get: if /a/b == /a/b;\n    }\n    match /c_interpolate_whole/{doc} {\n      allow get: if /$('a/b') == /a/b;\n    }\n    match /c_path_fn/{doc} {\n      allow get: if path('/a/b') == /a/b;\n    }\n    match /c_path_size/{doc} {\n      allow get: if /a/b/c.size() == 3;\n    }\n    match /c_path_bind/{doc} {\n      allow get: if /a/$(x)/c.bind({'x': 'b'}) == /a/b/c;\n    }\n  }\n}\n"
       }
      ]
     },
