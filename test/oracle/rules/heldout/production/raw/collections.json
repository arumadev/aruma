    "body": {
     "source": {
      "files": [
       {
        "name": "firestore.rules",
        "content": "rules_version = '2';\nservice cloud.firestore {\n  match /databases/{database}/documents {\n    match /c_list_in/{doc} {\n      allow get: if 1 in [1, 2];\n    }\n    match /c_list_hasall/{doc} {\n      allow get: if [1, 2].hasAll([1]);\n    }\n    match /c_list_hasany_false/{doc} {\n      allow get: if [1, 2].hasAny([3]);\n    }\n    match /c_list_concat/{doc} {\n      allow get: if [1, 2].concat([3]) == [1, 2, 3];\n    }\n    match /c_list_index/{doc} {\n      allow get: if [1, 2, 3][1] == 2;\n    }\n    match /c_list_index_float/{doc} {\n      allow get: if [1, 2, 3][1.0] == 2;\n    }\n    match /c_list_tostring_compare/{doc} {\n      allow get: if ['b', 'a'] < ['c'];\n    }\n    match /c_set_size/{doc} {\n      allow get: if [1, 1, 2].toSet().size() == 2;\n    }\n    match /c_set_in/{doc} {\n      allow get: if 1 in [1].toSet();\n    }\n    match /c_set_union/{doc} {\n      allow get: if [1].toSet().union([2].toSet()) == [1, 2].toSet();\n    }\n    match /c_set_hasall_list/{doc} {\n      allow get: if [1, 2].toSet().hasAll([1]);\n    }\n    match /c_set_difference_list_arg/{doc} {\n      allow get: if [1, 2].toSet().difference([2]) == [1].toSet();\n    }\n    match /c_set_index/{doc} {\n      allow get: if [1].toSet()[0] == 1;\n    }\n    match /c_map_in_value/{doc} {\n      allow get: if 1 in {'a': 1};\n    }\n    match /c_map_dot/{doc} {\n      allow get: if {'a': 1}.a == 1;\n    }\n    match /c_map_index/{doc} {\n      allow get: if {'a': 1}['a'] == 1;\n    }\n    match /c_doc_keys_hasall/{doc} {\n      allow get: if resource.data.keys().hasAll(['n', 'f']);\n    }\n  }\n}\n"
       }
      ]
     },
