    "body": {
     "source": {
      "files": [
       {
        "name": "firestore.rules",
        "content": "rules_version = '2';\nservice cloud.firestore {\n  match /databases/{database}/documents {\n    match /c_size_e_acute/{doc} {\n      allow get: if 'é'.size() == 1;\n    }\n    match /c_matches_anchors/{doc} {\n      allow get: if 'abc'.matches('^abc$');\n    }\n    match /c_matches_case_flag/{doc} {\n      allow get: if 'ABC'.matches('(?i)abc');\n    }\n    match /c_matches_digit_one_backslash/{doc} {\n      allow get: if '123'.matches('\\d+');\n    }\n    match /c_matches_unicode_class/{doc} {\n      allow get: if 'é'.matches('\\\\p{L}');\n    }\n    match /c_matches_dot_e_acute/{doc} {\n      allow get: if 'é'.matches('.');\n    }\n    match /c_matches_named_group/{doc} {\n      allow get: if 'ab'.matches('(?P<n>a)b');\n    }\n    match /c_split_dot_is_regex_empty/{doc} {\n      allow get: if 'a.b'.split('.') == [];\n    }\n    match /c_split_escaped_dot/{doc} {\n      allow get: if 'a.b'.split('[.]') == ['a', 'b'];\n    }\n    match /c_lower_ascii/{doc} {\n      allow get: if 'ABC'.lower() == 'abc';\n    }\n    match /c_trim_spaces/{doc} {\n      allow get: if '  a  '.trim() == 'a';\n    }\n    match /c_trim_ideographic_space/{doc} {\n      allow get: if '\\u3000a'.trim() == 'a';\n    }\n    match /c_index_negative/{doc} {\n      allow get: if 'abc'[-1] == 'c';\n    }\n    match /c_compare_case/{doc} {\n      allow get: if 'B' < 'a';\n    }\n    match /c_string_of_large_float/{doc} {\n      allow get: if string(10000000000000000000000.0) == '1.0E22';\n    }\n    match /c_int_truncates/{doc} {\n      allow get: if int(1.9) == 1 && int(-1.9) == -1;\n    }\n    match /c_escape_octal/{doc} {\n      allow get: if '\\101' == 'A';\n    }\n    match /c_string_times_int/{doc} {\n      allow get: if 'ab' * 2 == 'abab';\n    }\n  }\n}\n"
       }
      ]
     },
     "testSuite": {
