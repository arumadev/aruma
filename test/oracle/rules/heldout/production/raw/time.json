     "source": {
      "files": [
       {
        "name": "firestore.rules",
        "content": "rules_version = '2';\nservice cloud.firestore {\n  match /databases/{database}/documents {\n    match /c_year/{doc} {\n      allow get: if request.time.year() == 2026;\n    }\n    match /c_month/{doc} {\n      allow get: if request.time.month() == 3;\n    }\n    match /c_to_millis/{doc} {\n      allow get: if request.time.toMillis() == 1772600767123;\n    }\n    match /c_ts_date_type/{doc} {\n      allow get: if timestamp.date(2026, 3, 4) is timestamp;\n    }\n    match /c_duration_plus_ts/{doc} {\n      allow get: if duration.value(1, 'd') + request.time > request.time;\n    }\n    match /c_ts_minus_ts_seconds/{doc} {\n      allow get: if (request.time - timestamp.date(2026, 3, 4)).seconds() == 18367;\n    }\n    match /c_ts_gt_int/{doc} {\n      allow get: if request.time > 1;\n    }\n    match /c_units_ns/{doc} {\n      allow get: if duration.value(1, 'ms') == duration.value(1000000, 'ns');\n    }\n    match /c_duration_abs/{doc} {\n      allow get: if duration.abs(duration.value(-5, 's')) == duration.value(5, 's');\n    }\n    match /c_duration_times_int/{doc} {\n      allow get: if duration.value(1, 's') * 2 == duration.value(2, 's');\n    }\n  }\n}\n"
       }
      ]
     },
