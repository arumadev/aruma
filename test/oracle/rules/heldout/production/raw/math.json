     "source": {
      "files": [
       {
        "name": "firestore.rules",
        "content": "rules_version = '2';\nservice cloud.firestore {\n  match /databases/{database}/documents {\n    match /c_int_plus_float/{doc} {\n      allow get: if 1 + 1.5 == 2.5 && (1 + 1.5) is float;\n    }\n    match /c_int_div_is_int/{doc} {\n      allow get: if (3 / 2) is int && 3 / 2 == 1;\n    }\n    match /c_int_float_map_eq/{doc} {\n      allow get: if {'a': 1} == {'a': 1.0};\n    }\n    match /c_int_float_in_list/{doc} {\n      allow get: if 1 in [1.0];\n    }\n    match /c_floor_negative/{doc} {\n      allow get: if math.floor(-1.2) == -2.0;\n    }\n    match /c_max_absent/{doc} {\n      allow get: if math.max(1, 2) == 2;\n    }\n    match /c_sha256_base64/{doc} {\n      allow get: if hashing.sha256('abc').toBase64() == 'ungWv48Bz+pBQUDeXa4iI7ADYaOWF3qctBD/YfIAFa0=';\n    }\n    match /c_crc32c/{doc} {\n      allow get: if hashing.crc32c('abc') == b'\\x36\\x4b\\x3f\\xb7';\n    }\n    match /c_bytes_eq_string/{doc} {\n      allow get: if b'abc' == 'abc';\n    }\n    match /c_latlng_distance/{doc} {\n      allow get: if latlng.value(0.0, 0.0).distance(latlng.value(0.0, 1.0)) > 111000;\n    }\n  }\n}\n"
       }
      ]
     },
