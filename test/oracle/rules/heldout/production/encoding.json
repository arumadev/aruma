 "version": "firebaserules.googleapis.com v1 projects.test",
 "rulesets": {
  "pack-1": "rules_version = '2';\nservice cloud.firestore {\n  match /databases/{database}/documents {\n    match /c_json_2pow53_plus1/{doc} {\n      allow get: if resource.data.g == 9007199254740993;\n    }\n    match /c_json_huge_number/{doc} {\n      allow get: if resource.data.g is float;\n    }\n    match /c_resource_id/{doc} {\n      allow get: if resource.id == 'doc';\n    }\n    match /c_resource_name_absent/{doc} {\n      allow get: if resource.__name__ == null || true;\n    }\n    match /c_request_resource_absent_on_get/{doc} {\n      allow get: if request.resource == null;\n    }\n    match /c_auth_token_nested/{doc} {\n      allow get: if request.auth.token.firebase.sign_in_provider == 'password';\n    }\n    match /c_auth_token_bool/{doc} {\n      allow get: if request.auth.token.admin == true;\n    }\n    match /c_auth_token_missing_claim/{doc} {\n      allow get: if request.auth.token.missing == true;\n    }\n    match /c_auth_without_token_size/{doc} {\n      allow get: if request.auth.token.size() == 0;\n    }\n  }\n}\n"
 },
 "resources": {
  "default": {
   "data": {
    "n": 1,
    "f": 1.5,
    "s": "abc",
    "b": true,
    "nul": null,
    "arr": [
     1,
     2,
     3
    ],
    "tags": [
     "a",
     "b"
    ],
    "m": {
     "x": 1,
     "y": "z"
    },
    "owner": "alice"
   }
  }
 },
