 "rulesets": {
  "pack-1": "rules_version = '2';\nservice cloud.firestore {\n  match /databases/{database}/documents {\n    function errf() { return resource.data.missing == 1; }\n    function lazyLet() { let x = resource.data.missing; return true; }\n    function usedLet() { let x = resource.data.missing; return x == 1 || true; }\n    function nonBool() { return 1; }\n    function ignores(a) { return true; }\n    function uses(a) { return a == 1 || true; }\n    match /c_missing_eq_null/{doc} {\n      allow get: if resource.data.missing == null;\n    }\n    match /c_not_err_or_true/{doc} {\n      allow get: if !(resource.data.missing == 1) || true;\n    }\n    match /c_let_used_err_or_true/{doc} {\n      allow get: if usedLet();\n    }\n    match /c_index_missing_key/{doc} {\n      allow get: if resource.data['missing'] == 1;\n    }\n    match /c_list_lt_list/{doc} {\n      allow get: if [1] < [2];\n    }\n    match /c_bool_lt_bool/{doc} {\n      allow get: if false < true;\n    }\n    match /c_mod_zero/{doc} {\n      allow get: if 1 % 0 == 0;\n    }\n    match /c_int_max_plus_one_or_true/{doc} {\n      allow get: if (9223372036854775807 + 1 < 0) || true;\n    }\n    match /c_int_max_times_two/{doc} {\n      allow get: if 9223372036854775807 * 2 < 0;\n    }\n    match /c_int_min_negate/{doc} {\n      allow get: if -(-9223372036854775807 - 1) < 0;\n    }\n    match /c_int_max_literal/{doc} {\n      allow get: if 9223372036854775807 > 0;\n    }\n    match /c_int_min_literal/{doc} {\n      allow get: if -9223372036854775808 < 0;\n    }\n  }\n}\n"
 },
 "resources": {
  "default": {
   "data": {
    "n": 1,
    "f": 1.5,
    "s": "abc",
    "b": true,
    "nul": null,
    "arr": [
     1,
     2,
     3
    ],
    "tags": [
     "a",
     "b"
    ],
    "m": {
     "x": 1,
     "y": "z"
    },
    "owner": "alice"
   }
  }
 },
