{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://aruma.dev/schema/service-account-key.json",
  "title": "Service account key file",
  "type": "object",
  "required": ["type", "project_id", "private_key_id", "private_key", "client_email", "client_id", "auth_uri", "token_uri", "auth_provider_x509_cert_url", "client_x509_cert_url"],
  "additionalProperties": false,
  "properties": {
    "type": { "const": "service_account" },
    "project_id": { "type": "string", "pattern": "^[a-z][a-z0-9-]{4,28}[a-z0-9]$" },
    "private_key_id": { "type": "string", "pattern": "^[0-9a-f]{40}$" },
    "private_key": { "type": "string", "pattern": "^-----BEGIN PRIVATE KEY-----\n[\\s\\S]+\n-----END PRIVATE KEY-----\n$" },
    "client_email": { "type": "string", "pattern": "^[a-z][a-z0-9-]{4,28}[a-z0-9]@[a-z][a-z0-9-]{4,28}[a-z0-9]\\.sa\\..+$" },
    "client_id": { "type": "string", "pattern": "^[1-9][0-9]{20}$" },
    "auth_uri": { "type": "string", "pattern": "^https?://" },
    "token_uri": { "type": "string", "pattern": "^https?://.+/oauth2/v1/token$" },
    "auth_provider_x509_cert_url": { "type": "string", "pattern": "^https?://" },
    "client_x509_cert_url": { "type": "string", "pattern": "^https?://" }
  }
}
