      .snippet { margin: auto 0 0; padding: 10px 12px; border-radius: 8px; background: var(--code-bg); color: #c9d3f5; font-size: 12px; white-space: pre-wrap; word-break: break-word; }
      .tree { margin: 0; font-size: 14px; line-height: 1.7; }
      .v { color: #ffd58a; border-radius: 4px; }
