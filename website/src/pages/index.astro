      .lead { margin: 24px 0 0; font-size: 20px; color: var(--muted); max-width: 34em; }
      .cta { display: flex; flex-wrap: wrap; gap: 12px; margin-top: 32px; }
      .copy-line { margin-top: 22px; display: inline-flex; align-items: center; gap: 4px; max-width: 100%; border: 1px solid var(--line); border-radius: 12px; background: var(--panel); padding: 6px 6px 6px 16px; font-size: 14px; }
      .copy-line code { overflow-x: auto; white-space: nowrap; }
      .copy { min-height: 36px; padding: 0 12px; border-radius: 8px; border: 1px solid var(--line); background: var(--panel-2); color: var(--text); font: 500 13px var(--font); cursor: pointer; }

      .hero-visual { position: relative; display: grid; gap: 0; }
      .window { border: 1px solid var(--line); border-radius: var(--radius); background: var(--code-bg); color: #dfe6ff; box-shadow: var(--shadow); overflow: hidden; }
      .win-bar { display: flex; align-items: center; gap: 7px; padding: 12px 16px; border-bottom: 1px solid rgb(255 255 255 / 0.07); font: 500 13px var(--mono); color: #8b97bd; }
      .win-bar i { width: 11px; height: 11px; border-radius: 50%; background: #2a3558; }
      .win-bar span { margin-left: 8px; }
      .tag { margin-left: auto; font-style: normal; font-size: 12px; padding: 2px 9px; border-radius: 999px; background: rgb(15 216 198 / 0.14); color: #4be8da; }
      .window pre { margin: 0; padding: 18px 20px; font-size: 14px; line-height: 1.7; overflow-x: auto; }
      .k { color: var(--k); }
      .s { color: var(--s); }
      .code-window pre { padding-bottom: 52px; }
      .code-window { transition: transform 0.25s ease-out; transform-origin: center; }
      .term-window { width: 86%; margin: -34px 0 0 auto; position: relative; z-index: 2; }
      .term .line { display: inline-block; }
      .js .term .line { opacity: 0; transform: translateY(4px); transition: opacity 0.35s, transform 0.35s; }
      .term .line.on { opacity: 1; transform: none; }
      .term .ok { color: #4be8da; }
      .term .go { color: #86a6ff; }
      .caret { display: inline-block; width: 8px; height: 1.1em; vertical-align: -2px; background: #86a6ff; animation: blink 1s steps(1) infinite; margin-left: 2px; }
      .term.ran .caret { display: none; }
      @keyframes blink { 50% { opacity: 0; } }

      .marquee { position: relative; display: flex; align-items: center; gap: 24px; border-top: 1px solid var(--line); border-bottom: 1px solid var(--line); padding: 18px 24px; background: color-mix(in srgb, var(--bg-2) 70%, transparent); }
      .marquee-label { flex: none; font: 500 12px var(--mono); text-transform: uppercase; letter-spacing: 0.12em; color: var(--dim); }
      .marquee-track { overflow: hidden; flex: 1; mask-image: linear-gradient(to right, transparent, #000 8%, #000 92%, transparent); }
      .marquee-row { display: flex; gap: 56px; width: max-content; animation: slide 28s linear infinite; font-weight: 600; font-size: 18px; color: var(--muted); }
      @keyframes slide { to { transform: translateX(-50%); } }

      /* Sections */
      .section { padding: 112px 0; }
      .section.alt { background: var(--bg-2); border-top: 1px solid var(--line); border-bottom: 1px solid var(--line); }
      .kicker { margin: 0 0 14px; font: 500 13px var(--mono); letter-spacing: 0.08em; text-transform: uppercase; color: var(--accent); }
      h2 { margin: 0; font-size: clamp(34px, 4.6vw, 58px); line-height: 1.02; letter-spacing: -0.04em; font-weight: 800; text-wrap: balance; }
      .body { margin: 22px 0 0; color: var(--muted); font-size: 18px; max-width: 36em; }
      .body.narrow { max-width: 40em; }
