---
// The landing page. Built by hand; the docs under /docs/ stay on Starlight with the Lucode theme.
import { Image } from 'astro:assets';
import auth from '../assets/console-auth.png';
import rtdb from '../assets/console-rtdb.png';
import storage from '../assets/console-storage.png';

const base = import.meta.env.BASE_URL.replace(/\/?$/, '/');
const docs = (p: string) => `${base}docs/${p}`;
const repo = 'https://github.com/arumadev/aruma';
const title = 'Aruma: keep the Firebase SDK, own your backend';
const description =
  'A self-hosted backend that speaks the official Firebase SDKs. One Go binary and PostgreSQL. Open source under Apache 2.0.';
const ogImage = new URL(`${base}social-preview.png`, Astro.site).href;

const services = [
  { name: 'Authentication', state: 'Released', version: 'v0.1.0', text: 'Email, password, anonymous and identity providers through the Firebase Auth SDK.', link: docs('guides/auth-web/') },
  { name: 'Realtime Database', state: 'Released', version: 'v0.2.0', text: 'A live JSON tree with listeners, transactions and onDisconnect, over the same wire protocol.', link: docs('guides/realtime-database/') },
  { name: 'Security Rules', state: 'Released', version: 'v0.3.0', text: 'Your rules, evaluated on your server, checked case by case against Google’s own engine.', link: docs('guides/security-rules/') },
  { name: 'Cloud Storage', state: 'Released', version: 'v0.3.0', text: 'Uploads, downloads and metadata, stored on your disk and served by your binary.', link: docs('guides/storage/') },
  { name: 'Firestore', state: 'Release candidate', version: 'v0.4.0-rc.1', text: 'Documents, collections, queries and listeners through the Firestore SDKs.', link: docs('guides/firestore/') },
];
const planned = ['Cloud Messaging', 'App Check', 'Remote Config', 'Functions'];
const sdks = ['Web', 'iOS', 'Android', 'Flutter', 'Admin Node', 'Admin Go', 'firebase-tools'];
const shots = [
  { id: 'auth', label: 'Authentication', img: auth, alt: 'Aruma console: Authentication, listing a project’s users' },
  { id: 'rtdb', label: 'Realtime Database', img: rtdb, alt: 'Aruma console: Realtime Database data and databaseURL' },
  { id: 'storage', label: 'Storage', img: storage, alt: 'Aruma console: Cloud Storage usage' },
];
---

<!doctype html>
<html lang="en" dir="ltr">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{title}</title>
    <meta name="description" content={description} />
    <link rel="icon" href={`${base}favicon.svg`} type="image/svg+xml" />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:image" content={ogImage} />
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:image" content={ogImage} />
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link
      rel="stylesheet"
      href="https://fonts.googleapis.com/css2?family=Geist:wght@400;500;600;700;800&family=Geist+Mono:wght@400;500&display=swap"
    />
    <!-- Same storage key as the docs, so the choice carries across. -->
    <script is:inline>
      (() => {
        let t = '';
        try { t = localStorage.getItem('starlight-theme') || ''; } catch {}
        if (t !== 'light' && t !== 'dark') t = matchMedia('(prefers-color-scheme: light)').matches ? 'light' : 'dark';
        document.documentElement.dataset.theme = t;
      })();
    </script>
  </head>
  <body>
    <a class="skip" href="#main">Skip to content</a>

    <header class="nav" id="nav">
      <div class="wrap nav-row">
        <a class="brand" href={base} aria-label="Aruma home">
          <svg viewBox="0 0 100 100" width="26" height="26" aria-hidden="true"><path d="M2 98 C-2 34 30 4 98 2 Z" fill="#1446D8"></path><path d="M98 2 C98 66 70 98 2 98 Z" fill="#0FD8C6"></path></svg>
          <span>aruma</span>
        </a>
        <nav aria-label="Main" class="nav-links">
          <a href={docs('getting-started/')}>Docs</a>
          <a href="#services">Services</a>
          <a href="#proof">Proof</a>
          <a href={docs('changelog/')}>Changelog</a>
        </nav>
        <div class="nav-actions">
          <button class="icon-btn" id="theme" type="button" aria-label="Switch between light and dark">
            <svg class="sun" viewBox="0 0 24 24" width="18" height="18" aria-hidden="true"><circle cx="12" cy="12" r="4"></circle><path d="M12 2v2M12 20v2M4.9 4.9l1.4 1.4M17.7 17.7l1.4 1.4M2 12h2M20 12h2M4.9 19.1l1.4-1.4M17.7 6.3l1.4-1.4"></path></svg>
            <svg class="moon" viewBox="0 0 24 24" width="18" height="18" aria-hidden="true"><path d="M21 12.8A9 9 0 1 1 11.2 3a7 7 0 0 0 9.8 9.8Z"></path></svg>
          </button>
          <a class="icon-btn" href={repo} aria-label="Aruma on GitHub">
            <svg viewBox="0 0 24 24" width="18" height="18" aria-hidden="true" class="fill"><path d="M12 .5a11.5 11.5 0 0 0-3.6 22.4c.6.1.8-.3.8-.6v-2c-3.2.7-3.9-1.4-3.9-1.4-.5-1.3-1.3-1.7-1.3-1.7-1-.7.1-.7.1-.7 1.2.1 1.8 1.2 1.8 1.2 1 1.8 2.8 1.3 3.5 1 .1-.8.4-1.3.7-1.6-2.6-.3-5.3-1.3-5.3-5.7 0-1.3.5-2.3 1.2-3.1-.1-.3-.5-1.5.1-3.1 0 0 1-.3 3.2 1.2a11 11 0 0 1 5.8 0c2.2-1.5 3.2-1.2 3.2-1.2.6 1.6.2 2.8.1 3.1.8.8 1.2 1.8 1.2 3.1 0 4.4-2.7 5.4-5.3 5.7.4.4.8 1.1.8 2.2v3.3c0 .3.2.7.8.6A11.5 11.5 0 0 0 12 .5Z"></path></svg>
          </a>
          <a class="btn btn-primary btn-sm" href={docs('getting-started/')}>Get started</a>
        </div>
      </div>
    </header>

    <main id="main">
      <!-- Hero -->
      <section class="hero" id="hero">
        <div class="hero-bg" aria-hidden="true"></div>
        <div class="wrap hero-grid">
          <div class="hero-copy">
            <p class="eyebrow reveal"><span class="pulse" aria-hidden="true"></span>Open source · Self-hosted · Apache 2.0</p>
            <h1 class="reveal">
              Keep the Firebase SDK.<br />
              <span class="accent">Own your backend.</span>
            </h1>
            <p class="lead reveal">
              Aruma runs Auth, Realtime Database, Storage, Security Rules and Firestore on one Go binary and your
              PostgreSQL. Your apps keep the official Firebase SDKs. You keep your data, your bill and your rules.
            </p>
            <div class="cta reveal">
              <a class="btn btn-primary" href={docs('getting-started/')}>Start in five minutes <span aria-hidden="true">→</span></a>
              <a class="btn btn-ghost" href={repo}>Star on GitHub</a>
            </div>
            <div class="copy-line reveal">
              <code><span class="dim">$</span> git clone {repo}.git &amp;&amp; make dev</code>
              <button class="copy" type="button" data-copy={`git clone ${repo}.git && cd aruma && make dashboard && make dev`} aria-label="Copy the install commands">Copy</button>
            </div>
          </div>

          <div class="hero-visual reveal" aria-label="Your app code stays the same while Aruma serves it">
            <div class="window code-window tilt">
              <div class="win-bar"><i></i><i></i><i></i><span>app.js</span><em class="tag">unchanged</em></div>
              <pre><code><span class="k">import</span> {'{'} initializeApp {'}'} <span class="k">from</span> <span class="s">"firebase/app"</span>;
<span class="k">import</span> {'{'} getAuth {'}'} <span class="k">from</span> <span class="s">"firebase/auth"</span>;
<span class="k">import</span> {'{'} getDatabase {'}'} <span class="k">from</span> <span class="s">"firebase/database"</span>;
<span class="k">import</span> {'{'} getFirestore {'}'} <span class="k">from</span> <span class="s">"firebase/firestore"</span>;

<span class="k">const</span> app = initializeApp(config);
<span class="k">const</span> auth = getAuth(app);
<span class="k">const</span> db = getDatabase(app);</code></pre>
            </div>
            <div class="window term-window">
              <div class="win-bar"><i></i><i></i><i></i><span>your server</span></div>
              <pre class="term" id="term" aria-live="off"><code><span class="dim">$</span> <span class="typed" data-text="bin/aruma serve">bin/aruma serve</span><span class="caret" aria-hidden="true"></span>
<span class="line ok" data-delay="0">✓ PostgreSQL            connected</span>
<span class="line ok" data-delay="1">✓ Authentication        ready</span>
<span class="line ok" data-delay="2">✓ Realtime Database     ready</span>
<span class="line ok" data-delay="3">✓ Cloud Storage         ready</span>
<span class="line ok" data-delay="4">✓ Firestore             ready</span>
<span class="line go" data-delay="5">→ Console   http://localhost:8080</span></code></pre>
            </div>
          </div>
        </div>

        <div class="marquee" aria-label="Works with the official Firebase SDKs">
          <span class="marquee-label">Official SDKs</span>
          <div class="marquee-track">
            <div class="marquee-row">
              {[...sdks, ...sdks].map((s, i) => <span aria-hidden={i >= sdks.length ? 'true' : undefined}>{s}</span>)}
            </div>
          </div>
        </div>
      </section>

      <!-- One file -->
      <section class="section" id="how">
        <div class="wrap split">
          <div>
            <p class="kicker reveal">01 · How it works</p>
            <h2 class="reveal">Swap one file.<br /><span class="muted">Ship the same app.</span></h2>
            <p class="body reveal">
              Create a project in the console, download its config file and put it where Firebase’s was. No emulator mode,
              no fork of the SDK. For Auth, Realtime Database and Firestore on supported setups your application code does
              not change. A few platforms need one small helper, listed in <a href={docs('sdks/')}>SDK packages</a>.
            </p>
            <ol class="steps reveal">
              <li><span><b>Run</b> one binary next to PostgreSQL.</span></li>
              <li><span><b>Download</b> <code>google-services.json</code>, <code>GoogleService-Info.plist</code> or the web config.</span></li>
              <li><span><b>Ship.</b> Your queries, listeners and rules stay as they are.</span></li>
            </ol>
          </div>
          <div class="window diff-window reveal" id="diff">
            <div class="win-bar"><i></i><i></i><i></i><span>firebase-config.js</span><em class="tag">1 line changed</em></div>
            <pre><code><span class="k">const</span> app = initializeApp({'{'}
  projectId: <span class="s">"my-app"</span>,
  apiKey: <span class="s">"AIza…"</span>,
<span class="del">- databaseURL: <span class="s">"https://my-app.firebaseio.com"</span>,</span>
<span class="add">+ databaseURL: <span class="s">"https://<span class="typed-url" data-text="db.your-domain.com">db.your-domain.com</span>"</span>,</span>
{'}'});</code></pre>
          </div>
        </div>
      </section>

      <!-- Live demo -->
      <section class="section alt" id="live">
        <div class="wrap">
          <p class="kicker reveal">02 · Realtime</p>
          <h2 class="reveal">Write on one device.<br /><span class="muted">See it everywhere.</span></h2>
          <p class="body narrow reveal">
            Listeners, transactions and <code>onDisconnect</code> work over the same protocol your SDK already speaks. Try it:
            this is an in-page simulation of what the SDK does against your server.
          </p>
          <div class="live reveal">
            <div class="device">
              <div class="device-head"><span class="dot-a"></span>Phone A</div>
              <form class="send" id="send">
                <label for="msg" class="sr">Message</label>
                <input id="msg" name="msg" maxlength="40" autocomplete="off" placeholder="Type a message" />
                <button class="btn btn-primary btn-sm" type="submit">set()</button>
              </form>
              <pre class="snippet"><code>set(ref(db, <span class="s">"rooms/lobby/last"</span>), text)</code></pre>
            </div>
            <div class="wire" aria-hidden="true"><span class="packet" id="packet"></span></div>
            <div class="server">
              <div class="device-head"><span class="dot-s"></span>aruma · PostgreSQL</div>
              <pre class="tree" id="tree"><code>{'{'}
  <span class="s">"rooms"</span>: {'{'}
    <span class="s">"lobby"</span>: {'{'}
      <span class="s">"last"</span>: <span class="v" id="tree-last">"hello"</span>,
      <span class="s">"writes"</span>: <span class="v" id="tree-count">1</span>
    {'}'}
  {'}'}
{'}'}</code></pre>
            </div>
            <div class="wire" aria-hidden="true"><span class="packet" id="packet2"></span></div>
            <div class="device">
              <div class="device-head"><span class="dot-b"></span>Phone B</div>
              <p class="listen" aria-live="polite"><span class="dim">onValue →</span> <b id="b-val">hello</b></p>
              <pre class="snippet"><code>onValue(ref(db, <span class="s">"rooms/lobby/last"</span>), …)</code></pre>
            </div>
          </div>
        </div>
      </section>

      <!-- Services -->
      <section class="section" id="services">
        <div class="wrap">
          <p class="kicker reveal">03 · Services</p>
          <h2 class="reveal">Five Firebase services.<br /><span class="muted">One binary.</span></h2>
          <p class="body narrow reveal">
            A service ships when it passes against the official SDKs, not before. Every difference we know of is written
            down in <a href={docs('reference/known-differences/')}>known differences</a>.
          </p>
          <div class="cards">
            {services.map((s) => (
              <a class="card reveal" href={s.link}>
                <div class="card-top">
                  <span class={s.state === 'Released' ? 'badge ok' : 'badge rc'}>{s.state}</span>
                  <span class="ver">{s.version}</span>
                </div>
                <h3>{s.name}</h3>
                <p>{s.text}</p>
                <span class="more">Guide <span aria-hidden="true">→</span></span>
              </a>
            ))}
            <div class="card planned reveal">
              <div class="card-top"><span class="badge">Planned</span></div>
              <h3>Next</h3>
              <ul>{planned.map((p) => <li>{p}</li>)}</ul>
              <a class="more" href={`${repo}/issues`}>Tell us what you need <span aria-hidden="true">→</span></a>
            </div>
          </div>
        </div>
      </section>

      <!-- Proof -->
      <section class="proof" id="proof">
        <div class="wrap">
          <p class="kicker reveal">04 · Proof</p>
          <h2 class="reveal">We don’t ask you to trust us.<br /><span class="accent-2">We ran Google’s tests.</span></h2>
          <div class="stats">
            <div class="stat reveal">
              <div class="num"><span data-count="0">0</span></div>
              <p>writes lost out of <b><span data-count="101354">101,354</span></b> acknowledged, through <b>81</b> SIGKILLs of the server.</p>
            </div>
            <div class="stat reveal">
              <div class="num"><span data-count="332">332</span><small>/332</small></div>
              <p>official firebase-js-sdk Realtime Database tests pass in production mode.</p>
            </div>
            <div class="stat reveal">
              <div class="num"><span data-count="145">145</span><small>/153</small></div>
              <p>official Storage tests pass, unmodified. The other 8 are documented. None is an Aruma bug.</p>
            </div>
            <div class="stat reveal">
              <div class="num"><span data-count="10000">10,000</span></div>
              <p>Realtime Database connections held by a single server.</p>
            </div>
          </div>
          <p class="proof-links reveal">
            <a href={docs('benchmarks/')}>Benchmarks</a>
            <a href={docs('testing/')}>How we test</a>
            <a href={docs('reference/compatibility/')}>Compatibility reports</a>
          </p>
        </div>
      </section>

      <!-- Console -->
      <section class="section" id="console">
        <div class="wrap">
          <p class="kicker reveal">05 · The console</p>
          <h2 class="reveal">The console you know.<br /><span class="muted">In the same binary.</span></h2>
          <div class="tabs reveal" role="tablist" aria-label="Console screens">
            {shots.map((s, i) => (
              <button role="tab" type="button" id={`tab-${s.id}`} aria-controls={`panel-${s.id}`} aria-selected={i === 0 ? 'true' : 'false'} tabindex={i === 0 ? 0 : -1}>{s.label}</button>
            ))}
          </div>
          <div class="screen reveal">
            {shots.map((s, i) => (
              <div class="panel" role="tabpanel" id={`panel-${s.id}`} aria-labelledby={`tab-${s.id}`} hidden={i !== 0}>
                <Image src={s.img} alt={s.alt} widths={[720, 1440, 2160]} sizes="(min-width: 1200px) 1120px, 92vw" loading={i === 0 ? 'eager' : 'lazy'} />
              </div>
            ))}
          </div>
        </div>
      </section>

      <!-- Why -->
      <section class="section alt" id="why">
        <div class="wrap">
          <p class="kicker reveal">06 · Why self-host</p>
          <h2 class="reveal">Firebase’s developer experience.<br /><span class="muted">Without the lock-in.</span></h2>
          <div class="why">
            <div class="why-item reveal"><h3>Your data</h3><p>In your own PostgreSQL, in the region you choose. Back it up, query it, move it.</p></div>
            <div class="why-item reveal"><h3>Your bill</h3><p>You pay for a server, not for every read, write and download. A small VPS is enough to start.</p></div>
            <div class="why-item reveal"><h3>Your rules</h3><p>Run it in the cloud, on-premise or fully offline, wherever your users and your laws require.</p></div>
            <div class="why-item reveal"><h3>Your code</h3><p>Apache 2.0. Read every line, fork it, and send changes back.</p></div>
          </div>
        </div>
      </section>

      <!-- Final -->
      <section class="final" id="start">
        <div class="hero-bg" aria-hidden="true"></div>
        <div class="wrap final-inner">
          <h2 class="reveal">Your backend.<br /><span class="accent">Your server. Today.</span></h2>
          <div class="cta reveal">
            <a class="btn btn-primary" href={docs('getting-started/')}>Read the quick start <span aria-hidden="true">→</span></a>
            <a class="btn btn-ghost" href={repo}>View on GitHub</a>
          </div>
          <p class="fine reveal">
            Pre-1.0. Aruma does not serve Cloud Functions, so don’t use callable functions with Aruma Auth.
            See <a href={docs('reference/known-differences/')}>known differences</a>.
          </p>
        </div>
      </section>
    </main>

    <footer class="foot">
      <div class="wrap foot-row">
        <span>Aruma is open source under Apache 2.0.</span>
        <nav aria-label="Footer">
          <a href={docs('getting-started/')}>Docs</a>
          <a href={docs('security/')}>Security</a>
          <a href={docs('changelog/')}>Changelog</a>
          <a href={repo}>GitHub</a>
        </nav>
        <span>Firebase is a trademark of Google LLC. Aruma is not affiliated with Google.</span>
      </div>
    </footer>

    <script>
      const reduce = matchMedia('(prefers-reduced-motion: reduce)').matches;
      const root = document.documentElement;

      // Theme toggle, shared with the docs.
      document.getElementById('theme')?.addEventListener('click', () => {
        const next = root.dataset.theme === 'dark' ? 'light' : 'dark';
        root.dataset.theme = next;
        try { localStorage.setItem('starlight-theme', next); } catch {}
      });

      // Nav border once the page scrolls.
      const nav = document.getElementById('nav');
      const onScroll = () => nav?.classList.toggle('scrolled', scrollY > 8);
      addEventListener('scroll', onScroll, { passive: true });
      onScroll();

      // Cursor spotlight on the hero background.
      document.querySelectorAll<HTMLElement>('.hero, .final').forEach((el) => {
        el.addEventListener('pointermove', (e) => {
          const r = el.getBoundingClientRect();
          el.style.setProperty('--mx', `${e.clientX - r.left}px`);
          el.style.setProperty('--my', `${e.clientY - r.top}px`);
        });
      });

      // Gentle tilt on the hero code window.
      const tilt = document.querySelector<HTMLElement>('.tilt');
      const visual = document.querySelector<HTMLElement>('.hero-visual');
      if (tilt && visual && !reduce) {
        visual.addEventListener('pointermove', (e) => {
          const r = visual.getBoundingClientRect();
          const x = (e.clientX - r.left) / r.width - 0.5;
          const y = (e.clientY - r.top) / r.height - 0.5;
          tilt.style.transform = `perspective(900px) rotateY(${x * 6}deg) rotateX(${-y * 6}deg)`;
        });
        visual.addEventListener('pointerleave', () => (tilt.style.transform = ''));
      }

      // Copy buttons.
      document.querySelectorAll<HTMLButtonElement>('[data-copy]').forEach((b) => {
        b.addEventListener('click', async () => {
          try {
            await navigator.clipboard.writeText(b.dataset.copy ?? '');
            b.textContent = 'Copied';
          } catch {
            b.textContent = 'Press ⌘C';
          }
          setTimeout(() => (b.textContent = 'Copy'), 1600);
        });
      });

      // Typing helper.
      const type = (el: HTMLElement, speed = 45) =>
        new Promise<void>((done) => {
          const text = el.dataset.text ?? '';
          if (reduce) { el.textContent = text; return done(); }
          let i = 0;
          const tick = () => {
            el.textContent = text.slice(0, ++i);
            i < text.length ? setTimeout(tick, speed) : done();
          };
          tick();
        });

      // Hero terminal: type the command, then bring the services up one by one.
      const term = document.getElementById('term');
      if (term) {
        const cmd = term.querySelector<HTMLElement>('.typed');
        const lines = [...term.querySelectorAll<HTMLElement>('.line')];
        setTimeout(async () => {
          if (cmd) await type(cmd, 60);
          term.classList.add('ran');
          lines.forEach((l) => setTimeout(() => l.classList.add('on'), reduce ? 0 : 260 + Number(l.dataset.delay) * 230));
        }, reduce ? 0 : 700);
      }

      // Reveal on scroll, plus the one-shot animations tied to sections.
      const count = (el: HTMLElement) => {
        const to = Number(el.dataset.count);
        if (reduce || to === 0) { el.textContent = to.toLocaleString('en-US'); return; }
        const start = performance.now();
        const dur = 1400;
        const step = (t: number) => {
          const p = Math.min(1, (t - start) / dur);
          el.textContent = Math.round(to * (1 - Math.pow(1 - p, 3))).toLocaleString('en-US');
          if (p < 1) requestAnimationFrame(step);
        };
        el.textContent = '0';
        requestAnimationFrame(step);
      };
      const io = new IntersectionObserver(
        (entries) => {
          for (const e of entries) {
            if (!e.isIntersecting) continue;
            const el = e.target as HTMLElement;
            el.classList.add('in');
            el.querySelectorAll<HTMLElement>('[data-count]').forEach(count);
            if (el.id === 'diff') {
              setTimeout(() => {
                el.classList.add('run');
                const url = el.querySelector<HTMLElement>('.typed-url');
                if (url) setTimeout(() => type(url, 55), reduce ? 0 : 700);
              }, reduce ? 0 : 300);
            }
            io.unobserve(el);
          }
        },
        { threshold: 0.18 },
      );
      root.classList.add('js');
      document.querySelectorAll('.reveal').forEach((el) => io.observe(el));

      // Realtime simulation.
      const form = document.getElementById('send') as HTMLFormElement | null;
      const input = document.getElementById('msg') as HTMLInputElement | null;
      const p1 = document.getElementById('packet');
      const p2 = document.getElementById('packet2');
      const last = document.getElementById('tree-last');
      const cnt = document.getElementById('tree-count');
      const bVal = document.getElementById('b-val');
      let writes = 1;
      const flash = (el: Element | null) => {
        if (!el) return;
        el.classList.remove('flash');
        void (el as HTMLElement).offsetWidth;
        el.classList.add('flash');
      };
      const fly = (el: HTMLElement | null) => {
        if (!el) return;
        el.classList.remove('fly');
        void el.offsetWidth;
        el.classList.add('fly');
      };
      const send = (text: string) => {
        const value = text.trim() || 'hello';
        fly(p1);
        setTimeout(() => {
          writes += 1;
          if (last) last.textContent = JSON.stringify(value);
          if (cnt) cnt.textContent = String(writes);
          flash(last);
          fly(p2);
        }, reduce ? 0 : 420);
        setTimeout(() => {
          if (bVal) bVal.textContent = value;
          flash(bVal);
        }, reduce ? 0 : 840);
      };
      form?.addEventListener('submit', (e) => {
        e.preventDefault();
        send(input?.value ?? '');
        if (input) input.value = '';
      });

      // Console tabs, with arrow keys.
      const tabs = [...document.querySelectorAll<HTMLButtonElement>('[role="tab"]')];
      const select = (t: HTMLButtonElement) => {
        tabs.forEach((x) => {
          const on = x === t;
          x.setAttribute('aria-selected', String(on));
          x.tabIndex = on ? 0 : -1;
          const panel = document.getElementById(x.getAttribute('aria-controls') ?? '');
          if (panel) panel.hidden = !on;
        });
      };
      tabs.forEach((t, i) => {
        t.addEventListener('click', () => select(t));
        t.addEventListener('keydown', (e) => {
          const d = e.key === 'ArrowRight' ? 1 : e.key === 'ArrowLeft' ? -1 : 0;
          if (!d) return;
          const n = tabs[(i + d + tabs.length) % tabs.length];
          select(n);
          n.focus();
        });
      });
    </script>

    <style is:global>
      :root {
