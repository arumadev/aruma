      .cards .reveal:nth-child(2), .stats .reveal:nth-child(2), .why .reveal:nth-child(2) { transition-delay: 0.08s; }
      .cards .reveal:nth-child(3), .stats .reveal:nth-child(3), .why .reveal:nth-child(3) { transition-delay: 0.16s; }
      .cards .reveal:nth-child(4), .stats .reveal:nth-child(4), .why .reveal:nth-child(4) { transition-delay: 0.24s; }
      .cards .reveal:nth-child(5) { transition-delay: 0.32s; }
      .cards .reveal:nth-child(6) { transition-delay: 0.4s; }

      @media (max-width: 1000px) {
        .hero-grid, .split { grid-template-columns: 1fr; gap: 48px; }
        .cards { grid-template-columns: 1fr 1fr; }
        .stats, .why { grid-template-columns: 1fr 1fr; }
        .live { grid-template-columns: 1fr; gap: 0; }
        .wire { width: 2px; height: 36px; margin: 0 auto; background: repeating-linear-gradient(180deg, var(--line) 0 6px, transparent 6px 12px); }
        .packet { left: -4px !important; }
        .packet.fly { animation-name: fly-v; }
        @keyframes fly-v { 0% { top: 0; opacity: 1; } 100% { top: calc(100% - 10px); opacity: 1; } }
      }
      @media (max-width: 720px) {
        body { font-size: 16px; }
        .wrap { padding: 0 16px; }
        .nav-links { display: none; }
        .section { padding: 80px 0; }
        .hero { padding-top: 40px; }
        .cards, .stats, .why { grid-template-columns: 1fr; }
        .term-window { width: 100%; margin-top: 12px; }
        .lead { font-size: 18px; }
        .window pre { font-size: 12.5px; }
      }
      @media (prefers-reduced-motion: reduce) {
        *, *::before, *::after { animation: none !important; transition: none !important; scroll-behavior: auto !important; }
        .marquee-row { transform: none; }
      }
    </style>
