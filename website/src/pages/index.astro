      .server .device-head { color: #8b97bd; }
      .dot-a, .dot-b, .dot-s { width: 9px; height: 9px; border-radius: 50%; }
      .dot-a { background: var(--blue); } .dot-b { background: var(--teal); } .dot-s { background: #86a6ff; }
      .send { display: flex; gap: 8px; }
