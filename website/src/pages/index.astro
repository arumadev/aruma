      :root[data-theme='light'] {
        --bg: #f7f9ff;
        --bg-2: #eef2ff;
        --panel: #ffffff;
        --panel-2: #f3f6ff;
        --line: #dce3f5;
        --text: #0a1226;
        --muted: #4a5578;
        --dim: #66708f;
        --accent: #1446d8;
        --accent-2: #0a7d73;
        --primary: #1446d8;
        --primary-text: #fff;
        --code-bg: #0b1630;
        --k: #b69cff;
        --s: #7fe3c4;
        --glow: rgb(20 70 216 / 0.16);
