      .steps { margin: 28px 0 0; padding: 0; list-style: none; counter-reset: s; display: grid; gap: 14px; }
      .steps li { counter-increment: s; display: grid; grid-template-columns: 36px 1fr; gap: 12px; align-items: baseline; color: var(--muted); }
      .steps li::before { content: counter(s); display: grid; place-items: center; width: 30px; height: 30px; border-radius: 50%; border: 1px solid var(--line); font: 600 13px var(--mono); color: var(--accent); }
      .steps b { color: var(--text); }

      .diff-window pre { font-size: 15px; }
      .del, .add { display: inline-block; width: calc(100% + 40px); margin: 0 -20px; padding: 0 20px; transition: background 0.5s, color 0.5s; }
      .del { position: relative; }
      .del::after { content: ''; position: absolute; left: 34px; right: 24px; top: 50%; height: 1.5px; background: #ff8a8a; transform: scaleX(0); transform-origin: left; transition: transform 0.6s 0.2s; }
      .js .add { opacity: 0.25; }
      .run .del { background: rgb(255 92 92 / 0.12); color: #ffb3b3; }
      .run .del::after { transform: scaleX(1); }
      .run .add { opacity: 1; background: rgb(15 216 198 / 0.12); transition-delay: 0.6s; }

      /* Live demo */
      .live { margin-top: 48px; display: grid; grid-template-columns: 1fr 70px 1.1fr 70px 1fr; align-items: stretch; }
      .device, .server { border: 1px solid var(--line); border-radius: var(--radius); background: var(--panel); padding: 18px; display: flex; flex-direction: column; gap: 14px; box-shadow: var(--shadow); min-width: 0; }
