      .btn-primary:hover { box-shadow: 0 14px 40px -10px var(--glow), inset 0 1px 0 rgb(255 255 255 / 0.18); }
      .btn-ghost { color: var(--text); border-color: var(--line); background: color-mix(in srgb, var(--panel) 60%, transparent); }
