      .badge.ok { color: var(--accent-2); border-color: color-mix(in srgb, var(--accent-2) 40%, transparent); background: color-mix(in srgb, var(--accent-2) 10%, transparent); }
      .badge.rc { color: var(--accent); border-color: color-mix(in srgb, var(--accent) 40%, transparent); background: color-mix(in srgb, var(--accent) 10%, transparent); }
      .ver { font: 13px var(--mono); color: var(--dim); }
      .more { margin-top: auto; padding-top: 8px; font-weight: 600; font-size: 15px; color: var(--accent); }
      .planned { background: transparent; border-style: dashed; }
      .planned ul { margin: 0; padding: 0; list-style: none; display: flex; flex-wrap: wrap; gap: 8px; }
      .planned li { font-size: 14px; padding: 4px 10px; border-radius: 8px; background: var(--panel-2); color: var(--muted); }

      /* Proof */
      .proof { position: relative; padding: 120px 0; background: #050813; color: #eaf0ff; overflow: hidden; }
      .proof::before { content: ''; position: absolute; inset: -40% -10% auto; height: 120%; background: radial-gradient(closest-side, rgb(61 107 255 / 0.22), transparent); pointer-events: none; }
      .proof .wrap { position: relative; }
      .proof .kicker { color: #86a6ff; }
      .proof .accent-2 { color: #4be8da; }
      .stats { margin-top: 56px; display: grid; grid-template-columns: repeat(4, 1fr); gap: 1px; background: #1a2342; border: 1px solid #1a2342; border-radius: 20px; overflow: hidden; }
      .stat { background: #070b1a; padding: 32px 26px; }
      .num { font-size: clamp(48px, 5.4vw, 76px); font-weight: 800; letter-spacing: -0.05em; line-height: 1; color: #86a6ff; font-variant-numeric: tabular-nums; }
      .num small { font-size: 0.42em; color: #5f6d96; letter-spacing: -0.02em; margin-left: 4px; }
      .stat p { margin: 14px 0 0; color: #a7b2d4; font-size: 16px; }
      .stat b { color: #eaf0ff; font-weight: 600; font-variant-numeric: tabular-nums; }
      .proof-links { margin: 32px 0 0; display: flex; flex-wrap: wrap; gap: 24px; }
      .proof-links a { color: #86a6ff; font-weight: 600; }

      /* Console */
      .tabs { margin-top: 40px; display: inline-flex; gap: 4px; padding: 4px; border: 1px solid var(--line); border-radius: 999px; background: var(--panel); flex-wrap: wrap; }
      .tabs button { min-height: 40px; padding: 0 18px; border-radius: 999px; border: 0; background: transparent; color: var(--muted); font: 500 15px var(--font); cursor: pointer; }
      .tabs button[aria-selected='true'] { background: var(--primary); color: var(--primary-text); }
      .screen { margin-top: 20px; border: 1px solid var(--line); border-radius: 20px; padding: 10px; background: var(--panel); box-shadow: var(--shadow); }
      .screen img { display: block; width: 100%; height: auto; border-radius: 12px; }
      .panel:not([hidden]) { animation: fade 0.4s; }
      @keyframes fade { from { opacity: 0; transform: translateY(6px); } }

      /* Why */
      .why { margin-top: 48px; display: grid; grid-template-columns: repeat(4, 1fr); gap: 32px; }
      .why-item { border-top: 2px solid var(--accent); padding-top: 18px; }
      .why-item h3 { margin: 0; font-size: 20px; }
      .why-item p { margin: 8px 0 0; color: var(--muted); font-size: 16px; }

      /* Final */
      .final { position: relative; padding: 140px 0; overflow: hidden; text-align: center; }
      .final-inner { position: relative; display: flex; flex-direction: column; align-items: center; }
      .final h2 { font-size: clamp(42px, 6.4vw, 88px); }
      .final .cta { justify-content: center; }
      .fine { margin: 28px 0 0; color: var(--dim); font-size: 14px; max-width: 40em; }

      .foot { border-top: 1px solid var(--line); }
      .foot-row { display: flex; flex-wrap: wrap; gap: 16px 32px; justify-content: space-between; padding-top: 28px; padding-bottom: 28px; font-size: 14px; color: var(--dim); }
      .foot nav { display: flex; gap: 20px; }
      .foot a { color: var(--muted); }

      /* Reveal: only hide when the script runs, so the page reads without it. */
      .js .reveal { opacity: 0; transform: translateY(18px); transition: opacity 0.7s cubic-bezier(0.2, 0.7, 0.2, 1), transform 0.7s cubic-bezier(0.2, 0.7, 0.2, 1); }
